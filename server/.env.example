# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL connection string; falls back to embedded JSON/SQLite store if unconfigured)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegismind_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Security & Secrets
JWT_SECRET=super_secret_aegismind_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=24h

# Google Gemini AI Integration
GEMINI_API_KEY=your_actual_gemini_api_key_here
